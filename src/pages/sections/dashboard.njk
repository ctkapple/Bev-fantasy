---
pagination:
  data: leaguesByTab.dashboard
  size: 1
  alias: league
permalink: "/{{ league.slug }}/"
layout: layouts/league-shell.njk
currentTab: dashboard
eleventyComputed:
  title: "{{ league.name }} — Rankings"
---
{% set aggregate = leagueStats[league.slug].aggregates %}

<div id="dashboard-root" data-league="{{ league.slug }}" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-2">
  <div class="card lg:col-span-2">
    <h2 class="text-xl font-bold mb-4 text-accent-500">All-Time Standings</h2>
    {% if aggregate and aggregate.standings.length > 0 %}
    <div class="overflow-x-auto">
      <table class="stat-table">
        <thead>
          <tr>
            <th class="px-4 py-3">Rank</th>
            <th class="px-4 py-3">Manager</th>
            <th class="px-4 py-3">Record (<span class="win">W</span>-<span class="loss">L</span>)</th>
            <th class="px-4 py-3">Win %</th>
            <th class="px-4 py-3"><span class="win">PF</span> / <span class="loss">PA</span></th>
          </tr>
        </thead>
        <tbody id="power-rankings-body">
          {% for m in aggregate.standings %}
          <tr>
            <td class="px-4 py-3 font-semibold">{{ m.rank }}</td>
            <td class="px-4 py-3 flex items-center gap-2">
              <img src="{{ m.avatar }}" alt="" class="w-7 h-7 rounded-full cursor-pointer" onclick="window.expandAvatar && window.expandAvatar(this.src)">
              {{ m.displayName }}{% if m.userId == aggregate.reigningChampionId %} <span title="Reigning Champ">{% icon "crown", "icon" %}</span>{% endif %}
            </td>
            <td class="px-4 py-3"><span class="win">{{ m.wins }}</span>-<span class="loss">{{ m.losses }}</span>{% if m.ties %}-{{ m.ties }}{% endif %}</td>
            <td class="px-4 py-3">{{ (m.winPct * 100) | decimal1 }}%</td>
            <td class="px-4 py-3"><span class="win">{{ m.pf | decimal2 }}</span> / <span class="loss">{{ m.pa | decimal2 }}</span></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="text-text-secondary text-sm">No completed seasons yet — standings will appear once the first season is frozen into history.</p>
    {% endif %}
  </div>

  <div class="card" id="trophy-case-card">
    <h2 class="text-xl font-bold mb-4 text-yellow-400">{% icon "trophy", "icon mr-1" %}Trophy Case</h2>

    <div class="space-y-4">
      {% for c in aggregate.trophyCase.champions if aggregate %}
      <div class="flex items-center gap-3">
        <img src="{{ c.avatar }}" alt="{{ c.displayName }}" class="w-10 h-10 rounded-full object-cover border-2 border-yellow-400 cursor-pointer hover:scale-110 transition-transform" onclick="window.expandAvatar && window.expandAvatar(this.src)">
        <div>
          <p class="font-semibold">{{ c.displayName }}{% if c.userId == aggregate.reigningChampionId %} <span title="Reigning Champ">{% icon "crown", "icon" %}</span>{% endif %}</p>
          {% for y in c.years %}<p class="text-sm text-yellow-400">{% icon "trophy", "icon mr-1" %}{{ y }}</p>{% endfor %}
        </div>
      </div>
      {% else %}
      <p class="text-text-secondary text-sm">No champions yet!</p>
      {% endfor %}
    </div>

    {% if aggregate and aggregate.trophyCase.runnerUps.length > 0 %}
    <div class="space-y-4 mt-6">
      <h3 class="text-lg font-semibold text-text-secondary mb-2 border-t border-border pt-4">{% icon "medal", "icon mr-1" %}Runner Ups</h3>
      {% for r in aggregate.trophyCase.runnerUps %}
      <div class="flex items-center gap-3">
        <img src="{{ r.avatar }}" alt="{{ r.displayName }}" class="w-10 h-10 rounded-full object-cover border-2 border-gray-400 cursor-pointer hover:scale-110 transition-transform" onclick="window.expandAvatar && window.expandAvatar(this.src)">
        <div>
          <p class="font-semibold">{{ r.displayName }}</p>
          {% for y in r.years %}<p class="text-sm text-text-secondary">😢 {{ y }}</p>{% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {# Toilet Kings are hand-curated in league config - Sleeper has no notion of them. #}
    {% if league.toiletKings and league.toiletKings.length > 0 and aggregate %}
    <div class="space-y-4 mt-6">
      <h3 class="text-lg font-semibold text-amber-700 mb-2 border-t border-border pt-4">{% icon "toilet", "icon mr-1" %}Toilet King</h3>
      {% for king in league.toiletKings | groupToiletKings %}
        {% set m = aggregate.managers | managerByName(king.manager) %}
        {% if m %}
        <div class="flex items-center gap-3">
          <img src="{{ m.avatar }}" alt="{{ m.displayName }}" class="w-10 h-10 rounded-full object-cover border-2 border-amber-700 cursor-pointer hover:scale-110 transition-transform" onclick="window.expandAvatar && window.expandAvatar(this.src)">
          <div>
            <p class="font-semibold">{{ m.displayName }}</p>
            {% for y in king.years %}<p class="text-sm text-text-secondary">💩 {{ y }}</p>{% endfor %}
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>
</div>

<p id="live-season-note" class="text-xs text-text-muted mt-6 hidden">Standings above include the live current season (updates ~hourly per visitor).</p>

<script id="dashboard-league-config" type="application/json">{{ league | dump | safe }}</script>
<script type="module" src="/assets/js/dashboard.js"></script>
