---
pagination:
  data: leaguesByTab.dashboard
  size: 1
  alias: league
permalink: "/{{ league.slug }}/"
layout: layouts/league-shell.njk
currentTab: dashboard
eleventyComputed:
  title: "{{ league.name }} — Rankings"
---
{# The Rankings tab, dressed as a standings desk. Three sections, all built
   from one pass over the aggregate (lib/rankings-model.js):

     The Rafters — every banner on the wall, newest first
     The Climb   — cumulative wins, season by season
     The Table   — the all-time standings blotter

   The three data-driven regions are rendered by lib/rankings-markup.js rather
   than by loops here, because src/scripts/dashboard.js has to redraw them from
   the same functions once the live current season is merged in. This file owns
   the page: cards, section heads, table head, notes, empty states. #}
{% set view = league | rankingsView(leagueStats, people) %}

{% if not view %}
<p class="text-text-secondary text-sm">No completed seasons yet — the desk opens once the first season is frozen into history.</p>
{% else %}

<div id="dashboard-root" class="rankings" data-league="{{ league.slug }}">

  {# --- The Rafters ------------------------------------------------------- #}
  <section class="card rank-rafters-card">
    <header class="rank-section-head">
      <div>
        <p class="rank-eyebrow">Hardware</p>
        <h2 class="rank-title">The Rafters</h2>
      </div>
      <p class="rank-section-note">Every banner {{ league.name }} has raised, newest first.</p>
    </header>
    <div class="rank-rafters" data-rafters>{{ view.rafters | raftersMarkup | safe }}</div>
  </section>

  {# --- The Climb --------------------------------------------------------- #}
  {# Gated on two seasons: one column of dots is not a chart. A young league
     gets the rafters and the table until it has a second year to plot. #}
  {% if view.hasClimb %}
  <section class="card rank-climb-card" data-climb>
    <header class="rank-section-head">
      <div>
        <p class="rank-eyebrow">Season by Season</p>
        <h2 class="rank-title">The Climb</h2>
      </div>
      <p class="rank-section-note">Career wins, stacking up season by season — everyone starts at 0. A <span class="rank-title-key">gold dot</span> is a season they went on to win it all. Click a manager to isolate them; Esc clears.</p>
    </header>

    <div class="rank-climb-body">
      <div class="rank-climb-scroll">
        <svg class="rank-chart" data-climb-svg viewBox="0 0 {{ view.climb.width }} {{ view.climb.height }}"
          role="img" aria-label="Cumulative regular-season wins for every manager, season by season">{{ view.climb | climbMarkup | safe }}</svg>
      </div>

      {# Ranked all-time, so the rail doubles as a standings preview. On desktop
         it sits as a right-hand rail beside the chart; on mobile it wraps below
         like a normal legend — same pattern as the Earnings equity curve. #}
      <div class="rank-legend" data-climb-legend role="group" aria-label="Isolate a manager on the chart">{{ view.rows | climbLegendMarkup | safe }}</div>
    </div>
  </section>
  {% endif %}

  {# --- The Table --------------------------------------------------------- #}
  <section class="card rank-table-card">
    <header class="rank-section-head">
      <div>
        <p class="rank-eyebrow">All-Time</p>
        <h2 class="rank-title">The Table</h2>
      </div>
      <p class="rank-section-note">Every season this league has played, summed. Click a column to sort.</p>
    </header>
    <div class="overflow-x-auto">
      <table class="stat-table rank-table">
        <thead>
          <tr>
            <th class="px-3 py-3" data-sort="rank">#<span class="sort-arrow"></span></th>
            <th class="px-3 py-3" data-sort="manager">Manager <span class="sort-arrow"></span></th>
            <th class="px-3 py-3 text-center rank-col-opt" data-sort="seasons" title="Seasons played">Sn <span class="sort-arrow"></span></th>
            <th class="px-3 py-3" data-sort="record">Record (<span class="win">W</span>-<span class="loss">L</span>) <span class="sort-arrow"></span></th>
            <th class="px-3 py-3 text-right" data-sort="pct">Win % <span class="sort-arrow"></span></th>
            <th class="px-3 py-3 text-right" data-sort="pf">PF <span class="sort-arrow"></span></th>
            <th class="px-3 py-3 text-right rank-col-opt" data-sort="pa">PA <span class="sort-arrow"></span></th>
            <th class="px-3 py-3 text-right" data-sort="diff">Diff <span class="sort-arrow"></span></th>
            <th class="px-3 py-3 text-center" data-sort="titles" title="Championships">Rings <span class="sort-arrow"></span></th>
            <th class="px-3 py-3 rank-col-opt" data-sort="best" title="Best regular-season finish">Best <span class="sort-arrow"></span></th>
            <th class="px-3 py-3" data-sort="form" title="Regular-season finish each season, oldest to newest">Form <span class="sort-arrow"></span></th>
          </tr>
        </thead>
        <tbody data-standings>{{ view.rows | standingsMarkup | safe }}</tbody>
      </table>
    </div>
    <p class="rank-hint">Rings counts championships; Best and Form are regular-season finishes, oldest season to newest — a tall bar is a good year, a flat one a season this manager wasn't here for.</p>
    <p id="live-season-note" class="rank-hint rank-live hidden"><span class="rank-live-dot"></span>Includes the live current season, refreshed about hourly per visitor.</p>
  </section>
</div>

<script id="dashboard-league-config" type="application/json">{{ league | dump | safe }}</script>
<script type="module" src="/assets/js/dashboard.js"></script>
{% endif %}
