---
pagination:
  data: leaguesByTab.poll
  size: 1
  alias: league
permalink: "/{{ league.slug }}/poll/"
layout: layouts/league-shell.njk
currentTab: poll
eleventyComputed:
  title: "{{ league.name }} — AP Poll"
  description: "Submit and view the Super Beef 3-Way AP Poll."
---
<div id="ap-poll-root" class="ap-poll-page" data-league="{{ league.slug }}">
  <section class="card" aria-labelledby="ap-poll-loading-title">
    <h1 id="ap-poll-loading-title" class="text-2xl font-bold text-accent-500">AP Poll</h1>
    <div class="bouncing-loader" aria-hidden="true"><div></div><div></div><div></div></div>
    <p class="text-center text-text-secondary" role="status">Loading the current poll…</p>
  </section>
</div>

<script type="module" src="/assets/js/ap-poll.js"></script>
