---
pagination:
  data: leaguesByTab.rules
  size: 1
  alias: league
permalink: "/{{ league.slug }}/rules/"
layout: layouts/league-shell.njk
currentTab: rules
eleventyComputed:
  title: "{{ league.name }} — Rules"
---
<div class="card max-w-none text-text-secondary">
  <h2 class="text-2xl font-bold text-text-primary mb-6">League Constitution</h2>
  <div class="space-y-6">
    <div>
      <h3 class="text-xl font-semibold mb-3 text-accent-500">League Rules</h3>
      <ul class="list-disc list-inside space-y-2 text-sm">
        {% for rule in league.rulesContent.leagueRules %}<li>{{ rule }}</li>{% endfor %}
      </ul>
    </div>
    <div>
      <h3 class="text-xl font-semibold mb-3 text-accent-500">Keeper Rules</h3>
      <ul class="list-disc list-inside space-y-2 text-sm">
        {% for rule in league.rulesContent.keeperRules %}<li>{{ rule }}</li>{% endfor %}
      </ul>
    </div>
    <div>
      <h3 class="text-xl font-semibold mb-3 text-accent-500">Trade Rules</h3>
      <ul class="list-disc list-inside space-y-2 text-sm">
        {% for rule in league.rulesContent.tradeRules %}<li>{{ rule }}</li>{% endfor %}
      </ul>
    </div>
  </div>
</div>
