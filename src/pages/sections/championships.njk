---
pagination:
  data: leaguesByTab.championships
  size: 1
  alias: league
permalink: "/{{ league.slug }}/rosters/"
layout: layouts/league-shell.njk
currentTab: rosters
eleventyComputed:
  title: "{{ league.name }} — Championships"
---
{% set aggregate = leagueStats[league.slug].aggregates %}
{% set historical = leagueStats[league.slug].historical %}

{% if not historical or historical.length == 0 %}
<p class="text-text-secondary text-sm">No completed seasons yet.</p>
{% else %}
<div class="space-y-6">
  {% for season in historical | reverse %}
    {% if season.championship %}
    {% set champ = season.managers[season.championship.winnerId] %}
    {% set runnerUp = season.managers[season.championship.loserId] %}
    <div class="card">
      <div class="flex items-center justify-between flex-wrap gap-2 mb-4">
        <h2 class="text-xl font-bold text-accent-500">{{ season.season }} Championship</h2>
        <span class="text-sm text-text-secondary">{{ champ.displayName if champ else "Unknown" }} defeated {{ runnerUp.displayName if runnerUp else "Unknown" }}</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <p class="font-semibold text-win mb-2">🏆 {{ champ.displayName if champ else "Unknown" }} — {{ season.championship.winnerScore | decimal1 if season.championship.winnerScore != null else "—" }}</p>
          {% if season.championship.winnerRoster.length > 0 %}
          <table class="stat-table">
            <tbody>
              {% for p in season.championship.winnerRoster %}
              <tr><td class="px-2 py-1 text-text-secondary">{{ p.position }}</td><td class="px-2 py-1">{{ p.name }}</td><td class="px-2 py-1 text-right">{{ p.score | decimal1 }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
          {% endif %}
        </div>
        <div>
          <p class="font-semibold text-text-secondary mb-2">{{ runnerUp.displayName if runnerUp else "Unknown" }} — {{ season.championship.loserScore | decimal1 if season.championship.loserScore != null else "—" }}</p>
          {% if season.championship.loserRoster.length > 0 %}
          <table class="stat-table">
            <tbody>
              {% for p in season.championship.loserRoster %}
              <tr><td class="px-2 py-1 text-text-secondary">{{ p.position }}</td><td class="px-2 py-1">{{ p.name }}</td><td class="px-2 py-1 text-right">{{ p.score | decimal1 }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
          {% endif %}
        </div>
      </div>
    </div>
    {% endif %}
  {% endfor %}
</div>
{% endif %}
