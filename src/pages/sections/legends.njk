---
pagination:
  data: leaguesByTab.legends
  size: 1
  alias: league
permalink: "/{{ league.slug }}/legacies/"
layout: layouts/league-shell.njk
currentTab: legacies
eleventyComputed:
  title: "{{ league.name }} — Legends"
---
{% from "partials/macros.njk" import legacyCard %}
{% set aggregate = leagueStats[league.slug].aggregates %}

{% if not aggregate or aggregate.seasons.length == 0 %}
<p class="text-text-secondary text-sm">No completed seasons yet.</p>
{% else %}
{% set mgrs = aggregate.managers %}
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

  <div class="card">
    <h2 class="text-xl font-bold mb-1 text-accent-500">Ring Chasers</h2>
    <p class="text-sm text-text-secondary mb-6">Players with the most appearances in the championship.</p>
    {% for p in aggregate.legacies.ringChasers %}
      {% set lines = [] %}
      {% for h in p.history %}
        {% set who = mgrs[h.managerId].displayName if mgrs[h.managerId] else "Unknown" %}
        {% set lines = (lines.push(h.season + " on " + who + "'s team (" + ("🏆 Won" if h.isWinner else "🥈 Lost") + ")"), lines) %}
      {% endfor %}
      {{ legacyCard(p.appearances, "APPEARANCES", p, lines) }}
    {% else %}
      <p class="text-sm text-text-secondary">Not enough data yet.</p>
    {% endfor %}
  </div>

  <div class="card">
    <h2 class="text-xl font-bold mb-1 text-accent-500">Loyalty Club</h2>
    <p class="text-sm text-text-secondary mb-6">Players we just can't quit. (Kept or drafted twice in a row)</p>
    {% for p in aggregate.legacies.loyaltyClub %}
      {% set lines = [] %}
      {% for h in p.history %}
        {% set who = mgrs[h.managerId].displayName if mgrs[h.managerId] else "Unknown" %}
        {% set lines = (lines.push("Kept by " + who + " for " + h.season), lines) %}
      {% endfor %}
      {{ legacyCard(p.count, "TIMES KEPT", p, lines) }}
    {% else %}
      <p class="text-sm text-text-secondary">Not enough multi-season data yet.</p>
    {% endfor %}
  </div>

</div>
{% endif %}
