---
pagination:
  data: leaguesByTab.h2h
  size: 1
  alias: league
permalink: "/{{ league.slug }}/h2h/"
layout: layouts/league-shell.njk
currentTab: h2h
eleventyComputed:
  title: "{{ league.name }} — Head-to-Head"
---
{% set aggregate = leagueStats[league.slug].aggregates %}

{% if not aggregate or aggregate.seasons.length == 0 %}
<p class="text-text-secondary text-sm">No completed seasons yet.</p>
{% else %}
<div class="card">
  <h2 class="text-xl font-bold mb-4 text-accent-500">Head-to-Head Comparison</h2>
  <p class="text-sm text-text-secondary text-center mb-4">Choose one face from each side to build a matchup.</p>
  <div class="h2h-picker" aria-label="Choose two managers to compare">
    <section class="h2h-picker-side" data-h2h-side-panel="1" aria-labelledby="h2h-side-1-label">
      <h3 id="h2h-side-1-label" class="h2h-picker-label">Side A</h3>
      <div class="h2h-face-grid" data-h2h-face-grid>
        {% for id, m in aggregate.managers %}
        <button type="button" class="h2h-face-button" data-h2h-manager-id="{{ id }}" data-h2h-side="1" data-manager-name="{{ m.displayName }}" aria-label="Select {{ m.displayName }} for side A" aria-pressed="false" title="{{ m.displayName }}">
          <img src="{{ m.avatar }}" alt="">
        </button>
        {% endfor %}
      </div>
    </section>

    <div class="h2h-picker-vs" aria-hidden="true">VS</div>

    <section class="h2h-picker-side" data-h2h-side-panel="2" aria-labelledby="h2h-side-2-label">
      <h3 id="h2h-side-2-label" class="h2h-picker-label">Side B</h3>
      <div class="h2h-face-grid" data-h2h-face-grid>
        {% for id, m in aggregate.managers %}
        <button type="button" class="h2h-face-button" data-h2h-manager-id="{{ id }}" data-h2h-side="2" data-manager-name="{{ m.displayName }}" aria-label="Select {{ m.displayName }} for side B" aria-pressed="false" title="{{ m.displayName }}">
          <img src="{{ m.avatar }}" alt="">
        </button>
        {% endfor %}
      </div>
    </section>
  </div>
  <div class="h2h-picker-actions">
    <button type="button" class="h2h-clear-button hidden" data-clear-h2h>Clear matchup</button>
  </div>
  <div id="h2h-result" class="text-center p-4 scroll-mt-4">
    <p class="text-text-secondary">Please select two managers to compare head-to-head</p>
  </div>
</div>

<script id="h2h-aggregate" type="application/json">{{ aggregate | dump | safe }}</script>
<script type="module" src="/assets/js/h2h.js?v=face-picker-v2"></script>
{% endif %}
