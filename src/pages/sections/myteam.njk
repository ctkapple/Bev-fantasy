---
pagination:
  data: leaguesByTab.myteam
  size: 1
  alias: league
permalink: "/{{ league.slug }}/myteam/"
layout: layouts/league-shell.njk
currentTab: myteam
eleventyComputed:
  title: "{{ league.name }} — My Team"
---
{% set aggregate = leagueStats[league.slug].aggregates %}

{% if not aggregate or aggregate.seasons.length == 0 %}
<p class="text-text-secondary text-sm">No completed seasons yet.</p>
{% else %}
<div class="card mb-6">
  <div class="poll-voter-heading">
    <h2 id="my-team-picker-heading">Which team are you?</h2>
  </div>
  <p class="poll-voter-instructions text-sm text-text-secondary">Choose your team to view its franchise history and stats.</p>
  <div class="poll-voter-grid" role="group" aria-labelledby="my-team-picker-heading">
    {% for id, m in aggregate.managers %}
    {% set latestTeam = m.teamNameHistory | last %}
    <button type="button" class="poll-voter-button" data-my-team-id="{{ id }}" aria-pressed="false">
      <span class="poll-voter-identity">
        <img src="{{ m.avatar }}" alt="" class="poll-voter-avatar">
        <span class="poll-pick-copy">
          <strong>{{ latestTeam.name if latestTeam and latestTeam.name else m.displayName }}</strong>
          <small>{{ m.displayName }}</small>
        </span>
      </span>
      <span class="poll-voter-state" aria-hidden="true"></span>
    </button>
    {% endfor %}
  </div>
</div>

<div id="my-team-data" class="hidden"></div>

<script id="myteam-data" type="application/json">{{ aggregate.managers | dump | safe }}</script>
<script id="myteam-reigning-champ" type="application/json">{{ aggregate.reigningChampionId | dump | safe }}</script>
<script type="module" src="/assets/js/myteam.js"></script>
{% endif %}
