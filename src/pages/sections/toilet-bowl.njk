---
pagination:
  data: "leaguesByTab['toilet-bowl']"
  size: 1
  alias: league
permalink: "/{{ league.slug }}/toilet-bowl/"
layout: layouts/league-shell.njk
currentTab: toilet-bowl
eleventyComputed:
  title: "{{ league.name }} — Toilet Bowl"
---
{% from "partials/macros.njk" import gameSide, gameHeader %}
{% set aggregate = leagueStats[league.slug].aggregates %}
{% set historical = leagueStats[league.slug].historical %}

<div class="card">
  <h2 class="text-2xl font-bold text-text-primary mb-6">Toilet Bowl Punishment History</h2>
  <p class="mb-4 text-text-secondary text-sm">These poor, toilet-bowl-losing souls, spent the first week of the NFL season camped out at the Anchor from dusk til' dawn. A mere 15-30 minutes taken off their sentence for every drink they consumed.</p>

  <h3 class="text-xl font-semibold mb-3 text-accent-500">{% icon "anchor", "icon mr-1" %}Departure Ledger</h3>
  <div class="space-y-4">
    {% for entry in league.toiletBowlLedger %}
    <div class="bg-bg/50 p-4 rounded-lg border border-border flex items-center justify-between flex-wrap gap-2 {% if league.punishmentGalleries[entry.year] %}cursor-pointer hover:border-accent-500 transition-colors{% endif %}"
         {% if league.punishmentGalleries[entry.year] %}data-gallery='{{ league.punishmentGalleries[entry.year] | dump | safe }}'{% endif %}>
      <div>
        <span class="font-bold text-lg text-accent-400">{{ entry.year }}:</span>
        <span class="ml-2 font-semibold">{{ entry.name }}</span>
      </div>
      <div class="text-right">
        <span class="text-xl">{{ entry.detail }}</span>
        <br>
        <span class="text-xs text-text-secondary">left at {{ entry.leftAt }}</span>
      </div>
    </div>
    {% endfor %}
  </div>

  <hr class="border-border my-8">

  {# Per-season game detail: full starting rosters and scores for both sides.
     Sleeper-derived seasons first, then any hand-entered ones (e.g. 2021,
     which predates the data this build fetches), all sorted newest-first. #}
  {% set games = [] %}
  {% for season in historical %}
    {% if season.toiletBowl %}
      {% set punished = season.managers[season.toiletBowl.punishedId] %}
      {% set safe = season.managers[season.toiletBowl.safeId] %}
      {% if punished and safe %}
        {% set games = (games.push({
          season: season.season, punished: punished, safe: safe,
          punishedScore: season.toiletBowl.punishedScore, safeScore: season.toiletBowl.safeScore,
          punishedRoster: season.toiletBowl.punishedRoster, safeRoster: season.toiletBowl.safeRoster
        }), games) %}
      {% endif %}
    {% endif %}
  {% endfor %}
  {# Manual entries only fill gaps. The build now reaches back further than the
     original site did (which is why 2021 was hand-entered there), so skip any
     manual season Sleeper already provided rather than rendering it twice. #}
  {% for manual in league.manualToiletBowls | excludeSeasonsIn(games) %}
    {% set punished = aggregate.managers | managerByName(manual.punishedManager) if aggregate else null %}
    {% set safe = aggregate.managers | managerByName(manual.safeManager) if aggregate else null %}
    {% if punished and safe %}
      {% set games = (games.push({
        season: manual.season, punished: punished, safe: safe,
        punishedScore: manual.punishedScore, safeScore: manual.safeScore,
        punishedRoster: manual.punishedRoster, safeRoster: manual.safeRoster
      }), games) %}
    {% endif %}
  {% endfor %}

  {% if games.length == 0 %}
  <p class="text-text-secondary text-center mt-6">No Toilet Bowl game data available yet.</p>
  {% else %}
  {% for game in games | sortBySeasonDesc %}
  <div class="mb-10">
    {{ gameHeader(game.season + " Toilet Bowl", "toilet-game-" + game.season, "text-amber-600") }}
    <div id="toilet-game-{{ game.season }}" class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {{ gameSide(game.punished, game.punishedScore, game.punishedRoster, {
        borderClass: "border-amber-600/50", ringClass: "border-amber-700",
        nameClass: "text-amber-600", icon: "toilet", label: "💩 Roster" }) }}
      {{ gameSide(game.safe, game.safeScore, game.safeRoster, {
        borderClass: "border-border", ringClass: "border-gray-400",
        nameClass: "text-text-primary", icon: "shield-check", label: "Safe Roster" }) }}
    </div>
  </div>
  {% endfor %}
  {% endif %}
</div>
