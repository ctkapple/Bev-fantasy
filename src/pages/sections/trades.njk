---
pagination:
  data: leaguesByTab.trades
  size: 1
  alias: league
permalink: "/{{ league.slug }}/trades/"
layout: layouts/league-shell.njk
currentTab: trades
eleventyComputed:
  title: "{{ league.name }} — Trade Log"
---
{% set feed = leagueStats[league.slug] | tradeFeed %}
{% set cards = feed | tradeCards %}

<section class="trade-log" aria-labelledby="trade-log-heading">
  <header class="trade-log-heading">
    <h2 id="trade-log-heading">Trade Log</h2>
    <p id="trade-live-status" class="trade-live-status" role="status" hidden></p>
  </header>

  <form id="trade-filters" class="trade-filters" role="search" aria-label="Filter trades" hidden>
    <div class="trade-filter-row">
      <label class="trade-search">Search
        <span class="trade-search-field">
          {% icon "search", "icon" %}
          <input type="search" name="query" placeholder="Players, managers, picks…" autocomplete="off">
        </span>
      </label>
      <label>Trade season<select name="season"></select></label>
      <label>Manager<select name="manager"></select></label>
      <button class="trade-more" id="trade-more" type="button" aria-expanded="false" aria-controls="trade-extra">
        {% icon "sliders-horizontal", "icon" %} More filters
      </button>
    </div>
    <div class="trade-extra" id="trade-extra" hidden>
      <label>Second manager<select name="secondManager"></select></label>
      <label>Position<select name="position"></select></label>
      <label>Pick year<select name="pickYear"></select></label>
      <label>Pick round<select name="pickRound"></select></label>
      <label class="trade-faab-filter"><input type="checkbox" name="faab"> Includes FAAB</label>
    </div>
    <div class="trade-filter-status">
      <span id="trade-count" aria-live="polite"></span>
      <button class="trade-clear" id="trade-clear" type="reset" hidden>Clear filters</button>
    </div>
  </form>

  <p id="trade-empty" class="trade-empty"{% if cards %} hidden{% endif %}>No completed trades yet.</p>
  <div id="trade-list" class="trade-list">{{ cards | safe }}</div>
</section>

<script id="trade-league-config" type="application/json">{{ league | dump | safe }}</script>
<script id="trade-snapshot" type="application/json">{{ feed | dump | safe }}</script>
<script type="module" src="/assets/js/trades.js"></script>
