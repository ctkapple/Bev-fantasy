---
pagination:
  data: leaguesByTab.earnings
  size: 1
  alias: league
permalink: "/{{ league.slug }}/earnings/"
layout: layouts/league-shell.njk
currentTab: earnings
eleventyComputed:
  title: "{{ league.name }} — Earnings"
---
{% set aggregate = leagueStats[league.slug].aggregates %}

{% if not aggregate or aggregate.seasons.length == 0 %}
<p class="text-text-secondary text-sm">No completed seasons yet.</p>
{% else %}

{% set market = aggregate.managers | earningsMarket(league.earnings) %}
{% set champ = aggregate.reigningChampionId %}

{% if market %}
<div class="exchange">

  {# --- Ticker tape ------------------------------------------------------ #}
  {# The track holds two identical copies of the tape so the CSS marquee can
     translate a full 50% and loop with no visible seam. #}
  <section class="exch-tape" aria-label="Lifetime winnings ticker">
    <div class="exch-tape-brand"><span class="exch-live-dot"></span>{{ league.slug | upper }}</div>
    <div class="exch-tape-window">
      <div class="exch-tape-track">
        {% for copy in [1, 2] %}
        <div class="exch-tape-run" {% if copy == 2 %}aria-hidden="true"{% endif %}>
          {% for r in market.tape %}
          <span class="exch-tape-item" data-ticker="{{ r.ticker }}">
            <img src="{{ r.manager.avatar }}" alt="" loading="lazy">
            <b>{{ r.ticker }}</b>
            <span class="exch-tape-price">{{ r.totalText }}</span>
            <span class="exch-tape-delta {{ 'is-up' if r.change > 0 else 'is-flat' }}">
              {{ "▲" if r.change > 0 else "▬" }} {{ r.changeText }}
            </span>
          </span>
          {% endfor %}
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {# --- Market summary --------------------------------------------------- #}
  <section class="exch-summary" aria-label="Market summary">
    <div class="exch-stat">
      <p class="exch-stat-label">Total Distributed</p>
      <p class="exch-stat-value">{{ market.summary.distributedText }}</p>
      <p class="exch-stat-sub">of {{ market.summary.potText }} collected · {{ market.summary.seasons }} seasons</p>
    </div>
    <div class="exch-stat">
      <p class="exch-stat-label">{{ market.summary.latestYear }} Pot</p>
      <p class="exch-stat-value">{{ market.summary.latestPotText }}</p>
      <p class="exch-stat-sub">${{ market.buyIn }} buy-in per manager</p>
    </div>
    <div class="exch-stat">
      <p class="exch-stat-label">All-Time Leader</p>
      <p class="exch-stat-value exch-stat-value--sym">
        <img src="{{ market.summary.leader.manager.avatar }}" alt="">{{ market.summary.leader.ticker }}
      </p>
      <p class="exch-stat-sub">{{ market.summary.leader.totalText }} · {{ market.summary.leader.name }}</p>
    </div>
    <div class="exch-stat">
      <p class="exch-stat-label">Biggest Single Year</p>
      <p class="exch-stat-value">{{ market.summary.biggest.amountText }}</p>
      <p class="exch-stat-sub">{{ market.summary.biggest.ticker }} in {{ market.summary.biggest.year }}</p>
    </div>
  </section>

  {# --- Cumulative equity curve ------------------------------------------ #}
  <section class="card exch-chart-card" data-earnings-chart>
    <header class="exch-section-head">
      <div>
        <p class="exch-eyebrow">Cumulative Performance</p>
        <h2 class="exch-title">Lifetime Equity Curve</h2>
      </div>
      <p class="exch-section-note">Running total of every dollar won, {{ market.years[0] }}–{{ market.summary.latestYear }}.</p>
    </header>

    <div class="exch-chart-scroll">
      <svg class="exch-chart" viewBox="0 0 {{ market.chart.width }} {{ market.chart.height }}"
        role="img" aria-label="Cumulative lifetime winnings for every manager by season">
        <defs>
          <linearGradient id="exch-leader-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#fb923c" stop-opacity="0.28"></stop>
            <stop offset="100%" stop-color="#fb923c" stop-opacity="0"></stop>
          </linearGradient>
        </defs>

        {% for t in market.chart.yTicks %}
        <g class="exch-gridline">
          <line x1="{{ market.chart.plotLeft }}" x2="{{ market.chart.plotRight }}" y1="{{ t.y }}" y2="{{ t.y }}"></line>
          <text x="{{ market.chart.plotLeft - 12 }}" y="{{ t.y + 4 }}" text-anchor="end">{{ t.label }}</text>
        </g>
        {% endfor %}

        {% for t in market.chart.xTicks %}
        <text class="exch-axis-x" x="{{ t.x }}" y="{{ market.chart.baselineY + 28 }}" text-anchor="middle">{{ t.label }}</text>
        {% endfor %}

        {% for s in market.chart.series %}
        {% if s.rank == 1 and s.areaD %}<path class="exch-area" d="{{ s.areaD }}" fill="url(#exch-leader-fill)"></path>{% endif %}
        {% endfor %}

        {# Painted worst-to-best so the leaders land on top of the pack. #}
        {% for s in market.chart.series | reverse %}
        <g class="exch-series {{ 'is-top' if s.isTop }}" data-ticker="{{ s.ticker }}" style="--line: {{ s.color }}">
          <path class="exch-line-hit" d="{{ s.d }}"></path>
          <path class="exch-line" d="{{ s.d }}"></path>
          {% for p in s.points %}
          <circle class="exch-dot" cx="{{ p.x }}" cy="{{ p.y }}" r="3.5"></circle>
          {% endfor %}
          {% if s.end %}
          <text class="exch-end-label" x="{{ s.end.x + 10 }}" y="{{ s.end.y + 4 }}">{{ s.ticker }}</text>
          {% endif %}
        </g>
        {% endfor %}
      </svg>
    </div>

    <div class="exch-legend" role="group" aria-label="Isolate a manager on the chart">
      {% for s in market.chart.series %}
      <button type="button" class="exch-legend-chip {{ 'is-top' if s.isTop }}" data-ticker="{{ s.ticker }}"
        style="--line: {{ s.color }}" aria-pressed="false"
        title="{{ s.name }} — {{ s.totalText }}">
        <img src="{{ s.avatar }}" alt="">
        <span class="exch-legend-sym">{{ s.ticker }}</span>
        <span class="exch-legend-val">{{ s.totalRoundText }}</span>
      </button>
      {% endfor %}
    </div>
    <p class="exch-hint">Hover a line or tap a manager to isolate their run.</p>
  </section>

  {# --- Holdings blotter -------------------------------------------------- #}
  <section class="card exch-blotter-card">
    <header class="exch-section-head">
      <div>
        <p class="exch-eyebrow">Positions</p>
        <h2 class="exch-title">Holdings</h2>
      </div>
      <p class="exch-section-note">Net is winnings less every ${{ market.buyIn }} buy-in paid. Click a column to sort.</p>
    </header>
    <div class="overflow-x-auto">
      <table class="stat-table exch-blotter">
        <thead>
          <tr>
            <th class="px-3 py-3" data-sort="sym">Sym <span class="sort-arrow"></span></th>
            <th class="px-3 py-3" data-sort="manager">Manager <span class="sort-arrow"></span></th>
            {% for y in market.years %}
            <th class="px-3 py-3 text-right" data-sort="y{{ y }}">{{ y }} <span class="sort-arrow"></span></th>
            {% endfor %}
            <th class="px-3 py-3 text-center" data-sort="trend">Trend <span class="sort-arrow"></span></th>
            <th class="px-3 py-3 text-right" data-sort="total">Total <span class="sort-arrow"></span></th>
            <th class="px-3 py-3 text-right" data-sort="net">Net <span class="sort-arrow"></span></th>
            <th class="px-3 py-3 text-right" data-sort="roi">ROI <span class="sort-arrow"></span></th>
          </tr>
        </thead>
        <tbody>
          {% for r in market.holdings %}
          <tr data-ticker="{{ r.ticker }}">
            <td class="px-3 py-2" data-value="{{ r.ticker }}"><span class="exch-sym">{{ r.ticker }}</span></td>
            <td class="px-3 py-2" data-value="{{ r.name }}">
              <span class="exch-holder">
                <img src="{{ r.manager.avatar }}" alt="" loading="lazy"
                  onclick="window.expandAvatar && window.expandAvatar(this.src)">
                <span class="truncate">{{ r.name }}{% if r.manager.userId == champ %} <span title="Reigning Champ">👑</span>{% endif %}</span>
              </span>
            </td>
            {% for c in r.cells %}
            <td class="px-3 py-2 text-right {{ 'exch-cell-empty' if not c.played }}" data-value="{{ c.value }}"
              {% if c.played and c.heat > 0.02 %}style="--heat: {{ c.heat }}"{% endif %}>{{ c.text }}</td>
            {% endfor %}
            <td class="px-3 py-2" data-value="{{ r.total }}">
              <svg class="exch-spark" viewBox="0 0 {{ r.spark.w }} {{ r.spark.h }}" width="{{ r.spark.w }}" height="{{ r.spark.h }}" aria-hidden="true">
                {% for b in r.spark.bars %}
                <rect x="{{ b.x }}" y="{{ b.y }}" width="{{ b.w }}" height="{{ b.h }}" rx="1"
                  class="{{ 'exch-spark-bar' if b.played else 'exch-spark-gap' }}"></rect>
                {% endfor %}
              </svg>
            </td>
            <td class="px-3 py-2 text-right exch-total" data-value="{{ r.total }}">{{ r.totalText }}</td>
            <td class="px-3 py-2 text-right font-semibold {{ 'win' if r.net >= 0 else 'loss' }}" data-value="{{ r.net }}">{{ r.netText }}</td>
            <td class="px-3 py-2 text-right {{ 'win' if r.net >= 0 else 'loss' }}" data-value="{{ r.net / r.paid if r.paid else 0 }}">{{ r.roiText }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="exch-hint">A dash means the manager wasn't in the league that season, so it costs them no buy-in.</p>
  </section>

  {# --- Secondary markets -------------------------------------------------- #}
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    {% for board in [
      { label: "Secondary Market", title: "Weekly Props", unit: "won", rows: market.props, key: "props" },
      { label: "Secondary Market", title: "Weekly High Scores", unit: "wks", rows: market.highs, key: "highs" }
    ] %}
    <section class="card exch-board-card">
      <header class="exch-section-head">
        <div>
          <p class="exch-eyebrow">{{ board.label }}</p>
          <h2 class="exch-title">{{ board.title }}</h2>
        </div>
      </header>
      <div class="exch-board">
        {% for r in board.rows %}
        <div class="exch-board-row">
          <img src="{{ r.manager.avatar }}" alt="" loading="lazy"
            onclick="window.expandAvatar && window.expandAvatar(this.src)">
          <span class="exch-sym">{{ r.ticker }}</span>
          <span class="exch-board-bar"><i style="width: {{ r.pct }}%"></i></span>
          <span class="exch-board-value">{{ r.props if board.key == "props" else r.highs }}
            <small>{{ board.unit }}</small></span>
        </div>
        {% endfor %}
      </div>
    </section>
    {% endfor %}
  </div>

  {# --- Prospectus --------------------------------------------------------- #}
  {% if league.earnings.payoutStructure %}
  <section class="card exch-prospectus">
    <header class="exch-section-head">
      <div>
        <p class="exch-eyebrow">Prospectus</p>
        <h2 class="exch-title">Payout Structure</h2>
      </div>
      <p class="exch-section-note">Where each season's pot goes.</p>
    </header>
    <dl class="exch-payouts">
      {% for item in [
        { k: "Buy-in", v: league.earnings.buyIn, note: "per manager" },
        { k: "Champion", v: league.earnings.payoutStructure.champion },
        { k: "Runner-Up", v: league.earnings.payoutStructure.runnerUp },
        { k: "3rd Place", v: league.earnings.payoutStructure.thirdPlace },
        { k: "Weekly High Score", v: league.earnings.payoutStructure.weeklyHighScore, note: "per week" },
        { k: "Weekly Prop", v: league.earnings.payoutStructure.weeklyProp, note: "per prop" }
      ] %}
      <div class="exch-payout">
        <dt>{{ item.k }}{% if item.note %} <small>{{ item.note }}</small>{% endif %}</dt>
        <dd>${{ item.v }}</dd>
      </div>
      {% endfor %}
    </dl>
    {% if league.earnings.note %}
    <p class="exch-disclosure"><span>Disclosure</span>{{ league.earnings.note }}</p>
    {% endif %}
  </section>
  {% endif %}
</div>

<script type="module" src="/assets/js/earnings.js"></script>

{% else %}
{# Leagues without a hand-entered ledger (bb) get the same exchange chrome at a
   smaller scale: championship payouts only, no per-year history to plot. #}
<div class="exchange">
  <section class="card exch-blotter-card max-w-3xl mx-auto">
    <header class="exch-section-head">
      <div>
        <p class="exch-eyebrow">Positions</p>
        <h2 class="exch-title">Lifetime Winnings</h2>
      </div>
    </header>
    {% set earners = aggregate.managers | championshipEarnings(league.earnings.payoutsByYear) %}
    {% if earners.length > 0 %}
    <div class="exch-board">
      {% for e in earners %}
      <div class="exch-board-row exch-board-row--simple">
        <span class="truncate font-semibold">{{ e.displayName }}</span>
        <span class="exch-total">${{ e.total }}</span>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="text-sm text-text-secondary">{{ league.earnings.note or "Earnings data hasn't been entered for this league yet." }}</p>
    {% endif %}
  </section>

  {% if league.earnings.payoutStructure %}
  <section class="card exch-prospectus max-w-3xl mx-auto">
    <header class="exch-section-head">
      <div>
        <p class="exch-eyebrow">Prospectus</p>
        <h2 class="exch-title">Payout Structure</h2>
      </div>
    </header>
    <dl class="exch-payouts">
      {% for item in [
        { k: "Buy-in", v: league.earnings.buyIn },
        { k: "Champion", v: league.earnings.payoutStructure.champion },
        { k: "Runner-Up", v: league.earnings.payoutStructure.runnerUp },
        { k: "3rd Place", v: league.earnings.payoutStructure.thirdPlace },
        { k: "Weekly High Score", v: league.earnings.payoutStructure.weeklyHighScore },
        { k: "Weekly Prop", v: league.earnings.payoutStructure.weeklyProp }
      ] %}
      <div class="exch-payout">
        <dt>{{ item.k }}</dt>
        <dd>${{ item.v }}</dd>
      </div>
      {% endfor %}
    </dl>
    {% if league.earnings.note %}<p class="exch-disclosure"><span>Disclosure</span>{{ league.earnings.note }}</p>{% endif %}
  </section>
  {% endif %}
</div>
{% endif %}
{% endif %}
