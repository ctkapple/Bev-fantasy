<div class="flex justify-end mb-4 sm:mb-0 sm:absolute sm:top-5 sm:right-4 md:right-8 z-40">
  <div class="relative inline-block text-left">
    <button id="switcher-button" type="button" class="btn-outline" aria-haspopup="true" aria-expanded="false">
      {% icon "layout-grid", "icon" %}
      <span>Leagues</span>
      {% icon "chevron-down", "icon" %}
    </button>
    <div id="switcher-menu" class="hidden absolute right-0 mt-2 w-48 bg-surface ring-1 ring-white/10 border border-border rounded-lg shadow-2xl overflow-hidden">
      <a href="/" class="switcher-item block px-4 py-2.5 text-sm text-text-primary hover:bg-accent-500 hover:text-black transition-colors border-b border-border">
        {% icon "house", "icon" %} Home
      </a>
      {% for other in leagues %}
        {% if other.slug != league.slug %}
        <a href="/{{ other.slug }}/" class="switcher-item block px-4 py-2.5 text-sm text-text-primary hover:bg-accent-500 hover:text-black transition-colors border-b border-border last:border-b-0">
          {{ other.name }}
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
