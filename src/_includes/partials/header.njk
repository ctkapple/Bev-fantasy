<header class="relative container mx-auto px-4 md:px-8 max-w-7xl pt-8 pb-6 text-center">
  {% include "partials/league-switcher.njk" %}

  <div class="flex flex-col items-center justify-center gap-3">
    <img
      src="{{ league.avatarUrl or 'https://placehold.co/112x112/1a1a1d/9ca3af?text=%F0%9F%8F%88' }}"
      alt="{{ league.name }} avatar"
      class="w-24 h-24 sm:w-28 sm:h-28 rounded-full ring-2 ring-accent-500/60 shadow-lg cursor-pointer hover:scale-105 transition-transform"
      onclick="window.expandAvatar && window.expandAvatar(this.src)"
    >
    <div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-display font-extrabold text-accent-500">
        {{ league.name }}
      </h1>
      <p class="text-sm sm:text-base text-text-secondary mt-2">{{ league.tagline }}</p>
    </div>
  </div>
</header>
