<div id="gallery-modal" class="fixed inset-0 bg-black/90 flex justify-center items-center z-[100] hidden p-4">
  <div class="relative w-full max-w-4xl h-full max-h-[90vh] flex items-center justify-center">
    <img id="gallery-modal-img" src="" alt="Gallery image" class="max-w-full max-h-full object-contain rounded-lg shadow-2xl select-none" draggable="false">
    <video id="gallery-modal-video" class="hidden max-w-full max-h-full rounded-lg shadow-2xl" controls playsinline preload="metadata"></video>
    <button id="gallery-modal-close" class="absolute top-0 right-0 m-4 bg-white text-black rounded-full h-10 w-10 flex items-center justify-center font-bold text-2xl leading-none" aria-label="Close">&times;</button>
    <button id="gallery-prev" class="absolute left-0 ml-2 md:ml-5 bg-white/30 hover:bg-white/50 text-black rounded-full h-12 w-12 flex items-center justify-center font-bold text-3xl leading-none backdrop-blur-sm">&lsaquo;</button>
    <button id="gallery-next" class="absolute right-0 mr-2 md:mr-5 bg-white/30 hover:bg-white/50 text-black rounded-full h-12 w-12 flex items-center justify-center font-bold text-3xl leading-none backdrop-blur-sm">&rsaquo;</button>
    <div id="gallery-counter" class="absolute bottom-0 mb-4 bg-black/50 text-white text-sm px-3 py-1 rounded-full"></div>
  </div>
</div>
